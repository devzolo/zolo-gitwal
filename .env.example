# Optional: the defaults already start a local stack with `docker compose up -d --build`.
# Build uses a pinned public Zolo release and dependency.

GITWAL_BIND_ADDRESS=127.0.0.1
GITWAL_HTTP_PORT=8080
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Local development credentials. Set unique credentials before network exposure.
RUSTFS_ACCESS_KEY=gitwal-local
RUSTFS_SECRET_KEY=gitwal-local-development-secret
GITWAL_S3_BUCKET=gitwal
AWS_REGION=us-east-1
GITWAL_WORKERS=2

# Optional SSH: set both, then `docker compose --profile ssh up -d --build`.
# Use the same token as HTTP to grant both transports access to the same repos.
# GITWAL_SSH_PUBLIC_KEY=ssh-ed25519 AAAA... your-key
# GITWAL_SSH_TOKEN=zgw_...
# GITWAL_SSH_PORT=2222
