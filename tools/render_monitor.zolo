//! Generate the embedded monitor from its canonical Verniz source.
//! Run from the project root: zolo run tools/render_monitor.zolo [-- OUTPUT]
use std::{fs, html, json, process}
use monitor::view

fn generate() -> nil fails str {
  let args = process.argv()
  if args.len() > 2 { fail "usage: zolo run tools/render_monitor.zolo -- [OUTPUT]" }
  let output = args?.[1] ?? "src/monitor_page.zolo"
  let source: str? = fs.read("src/monitor.zolo")
  if source is nil { fail "cannot read src/monitor.zolo; run from the project root" }
  let normalized = source.replace("\r\n", "\n")
  let signature = r#"pub fn page() -> http::Response {"#
  let start = normalized.index_of(signature)
  if start < 0 { fail "the monitor response function is missing" }
  let page = normalized.slice(start).trim_end()
  let render_expression = "view() |> html.render()"
  if page.count(render_expression) != 1 || !page.ends_with(r#"}"#) {
    fail "the monitor response must contain exactly one render expression"
  }

  let rendered = (view() |> html.render()).replace("\r\n", "\n")
  if !rendered.to_lower().starts_with("<!doctype html>") || !rendered.contains("</html>") ||
    !rendered.contains(r#"id="connect""#) {
    fail "the monitor render is incomplete"
  }
  // JSON escapes quotes, backslashes, and control characters. Escape braces
  // separately so the generated Zolo literal cannot introduce interpolation.
  let literal = json.encode(rendered).replace(r#"{"#, r#"\{"#).replace(r#"}"#, r#"\}"#)
  let generated = "// Generated by tools/render_monitor.zolo; edit src/monitor.zolo instead.\n" +
    "use std::http\n\n" + page.replace(render_expression, literal) + "\n"
  if fs.write(output, generated) is nil { fail "cannot write generated monitor" }
  print("Embedded monitor generated from Verniz with its original privacy headers.")
  nil
}

fn main() { generate().unwrap() }
