  http.response(
    200,
    "<!DOCTYPE html><html lang=\"en\"><head><style data-zolo-css>\n        :root \{\n          color-scheme: dark;\n          --bg: #0e141b;\n          --surface: #151e28;\n          --line: #2b3745;\n          --muted: #9aaabb;\n          --ink: #eff5fa;\n          --mint: #a4e7be;\n          --error: #ffaaaa;\n          font: 15px/1.55 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif\n        \}\n        * \{\n          box-sizing: border-box\n        \}\n        body \{\n          margin: 0;\n          background: var(--bg);\n          color: var(--ink)\n        \}\n        main \{\n          max-width: 1120px;\n          margin: auto;\n          padding: 40px 28px 64px\n        \}\n        header \{\n          display: flex;\n          justify-content: space-between;\n          align-items: center;\n          gap: 20px;\n          margin-bottom: 64px\n        \}\n        .brand \{\n          font-weight: 750;\n          letter-spacing: -.06em;\n          font-size: 28px\n        \}\n        .brand span \{\n          color: var(--mint)\n        \}\n        .badge \{\n          border: 1px solid var(--line);\n          border-radius: 24px;\n          padding: 5px 12px;\n          color: var(--muted);\n          font-size: 12px;\n          letter-spacing: .07em;\n          text-transform: uppercase\n        \}\n        .eyebrow \{\n          color: var(--mint);\n          text-transform: uppercase;\n          font-size: 12px;\n          letter-spacing: .16em;\n          margin: 0 0 12px\n        \}\n        h1 \{\n          font-size: clamp(32px,5vw,54px);\n          line-height: 1.12;\n          letter-spacing: -.055em;\n          margin: 0 0 16px\n        \}\n        h2 \{\n          font-size: 18px;\n          letter-spacing: -.025em;\n          margin: 0\n        \}\n        p \{\n          color: var(--muted);\n          margin: 0\n        \}\n        .intro \{\n          max-width: 680px;\n          margin-bottom: 34px\n        \}\n        form \{\n          display: grid;\n          grid-template-columns: 1fr 1.2fr auto;\n          gap: 14px;\n          align-items: end;\n          background: var(--surface);\n          border: 1px solid var(--line);\n          padding: 22px;\n          border-radius: 14px\n        \}\n        label \{\n          display: block;\n          font-weight: 600;\n          font-size: 12px;\n          color: #bfccda\n        \}\n        input:not([type=checkbox]) \{\n          display: block;\n          width: 100%;\n          margin-top: 7px;\n          padding: 12px 13px;\n          background: var(--bg);\n          border: 1px solid var(--line);\n          border-radius: 7px;\n          color: var(--ink);\n          font: inherit\n        \}\n        input:focus, button:focus-visible \{\n          outline: 2px solid var(--mint);\n          outline-offset: 3px\n        \}\n        button \{\n          cursor: pointer;\n          border: 1px solid var(--line);\n          border-radius: 7px;\n          padding: 12px 16px;\n          background: transparent;\n          color: var(--ink);\n          font: 600 14px/1.5 system-ui\n        \}\n        button.primary \{\n          background: var(--mint);\n          border-color: var(--mint);\n          color: #14251b\n        \}\n        button:disabled \{\n          opacity: .55;\n          cursor: wait\n        \}\n        .hint \{\n          font-size: 12px;\n          margin: 10px 0 28px\n        \}\n        .status \{\n          min-height: 24px;\n          font-size: 14px;\n          display: flex;\n          align-items: center;\n          gap: 10px\n        \}\n        .status.error \{\n          color: var(--error)\n        \}\n        .status.ok:before \{\n          content: \"\";\n          width: 7px;\n          height: 7px;\n          display: inline-block;\n          background: var(--mint);\n          border-radius: 50%\n        \}\n        .toolbar \{\n          display: flex;\n          align-items: center;\n          justify-content: space-between;\n          gap: 16px;\n          margin: 30px 0 22px\n        \}\n        .actions \{\n          display: flex;\n          align-items: center;\n          flex-wrap: wrap;\n          gap: 14px\n        \}\n        .actions label \{\n          display: flex;\n          align-items: center;\n          gap: 7px\n        \}\n        .actions button \{\n          padding: 8px 12px\n        \}\n        .metrics \{\n          display: grid;\n          grid-template-columns: repeat(4,1fr);\n          gap: 16px;\n          margin: 24px 0 34px\n        \}\n        .metric \{\n          border: 1px solid var(--line);\n          border-radius: 12px;\n          padding: 22px;\n          background: var(--surface)\n        \}\n        .metric dt \{\n          color: var(--muted);\n          font-size: 12px\n        \}\n        .metric dd \{\n          font-size: 32px;\n          letter-spacing: -.055em;\n          margin: 7px 0 0\n        \}\n        .metric dd.text \{\n          font-size: 21px;\n          line-height: 1.5;\n          overflow-wrap: anywhere\n        \}\n        section.panel \{\n          border: 1px solid var(--line);\n          border-radius: 12px;\n          overflow: hidden;\n          margin-bottom: 20px\n        \}\n        .panel-head \{\n          display: flex;\n          justify-content: space-between;\n          gap: 18px;\n          align-items: center;\n          padding: 20px;\n          background: var(--surface)\n        \}\n        .panel-head span \{\n          color: var(--muted);\n          font-size: 12px\n        \}\n        .table-wrap \{\n          overflow: auto\n        \}\n        table \{\n          border-collapse: collapse;\n          width: 100%;\n          font-size: 13px;\n          text-align: left\n        \}\n        th, td \{\n          padding: 15px 20px;\n          border-top: 1px solid var(--line)\n        \}\n        th \{\n          color: var(--muted);\n          font-size: 11px;\n          letter-spacing: .1em;\n          text-transform: uppercase;\n          font-weight: 500\n        \}\n        td code \{\n          font-size: 12px;\n          word-break: break-all\n        \}\n        td:first-child \{\n          white-space: nowrap\n        \}\n        .empty \{\n          padding: 32px 20px;\n          color: var(--muted);\n          font-size: 14px\n        \}\n        details \{\n          border: 1px solid var(--line);\n          border-radius: 12px;\n          padding: 18px 20px\n        \}\n        summary \{\n          cursor: pointer;\n          font-weight: 600;\n          font-size: 14px\n        \}\n        ol \{\n          color: var(--muted);\n          padding-left: 22px;\n          max-height: 230px;\n          overflow: auto;\n          font: 12px/1.9 ui-monospace,monospace\n        \}\n        .foot \{\n          margin-top: 34px;\n          font-size: 12px\n        \}\n        .hidden \{\n          display: none!important\n        \}\n        @media(max-width:720px) \{\n          main \{\n            padding: 25px 18px\n          \}\n          header \{\n            margin-bottom: 40px\n          \}\n          form \{\n            grid-template-columns: 1fr\n          \}\n          .metrics \{\n            grid-template-columns: 1fr 1fr;\n            gap: 10px\n          \}\n          .metric \{\n            padding: 16px\n          \}\n          .toolbar \{\n            align-items: flex-start;\n            flex-direction: column\n          \}\n          .panel-head \{\n            align-items: flex-start;\n            flex-direction: column;\n            gap: 3px\n          \}\n        \}\n      </style><meta charset=\"utf-8\"><meta content=\"width=device-width,initial-scale=1\" name=\"viewport\"><title>Gitwal · Repository monitor</title></head><body><main><header><div class=\"brand\">gitwal<span>.</span></div><span class=\"badge\">Repository monitor</span></header><div class=\"intro\"><p class=\"eyebrow\">Durable by design</p><h1>Your repository,<br>from the source of truth.</h1><p>Inspect published references and the durable write-ahead log. Each refresh reads the authoritative repository index.</p></div><form id=\"connect\"><label>Repository<input autocomplete=\"off\" id=\"repository\" maxlength=\"100\" placeholder=\"project.git\" required spellcheck=\"false\"></label><label>Access token <span style=\"font-weight:400;color:var(--muted)\">· optional for public repositories</span><input autocomplete=\"off\" id=\"token\" placeholder=\"zgw_…\" spellcheck=\"false\" type=\"password\"></label><button class=\"primary\" id=\"open\" type=\"submit\">Open repository</button></form><p class=\"hint\">Your token stays in this page&#39;s memory. It is never put in the address, saved to browser storage, or sent to another host.</p><p aria-live=\"polite\" class=\"status\" id=\"status\" role=\"status\">Choose a repository to inspect its published state.</p><button class=\"hidden\" id=\"retry\" type=\"button\">Try again</button><div class=\"hidden\" id=\"dashboard\"><div class=\"toolbar\"><h2 id=\"title\"></h2><div class=\"actions\"><label><input id=\"live\" type=\"checkbox\">Refresh every 15 seconds</label><button id=\"refresh\" type=\"button\">Refresh now</button><button id=\"disconnect\" type=\"button\">Disconnect</button></div></div><dl class=\"metrics\"><div class=\"metric\"><dt>Published references</dt><dd class=\"\" id=\"refs-count\">—</dd></div><div class=\"metric\"><dt>Active WAL entries</dt><dd class=\"\" id=\"wal-count\">—</dd></div><div class=\"metric\"><dt>Superseded entries</dt><dd class=\"\" id=\"old-count\">—</dd></div><div class=\"metric\"><dt>Object format</dt><dd class=\"text\" id=\"format\">—</dd></div></dl><section class=\"panel\"><div class=\"panel-head\"><h2>References</h2><span id=\"head\"></span></div><div class=\"table-wrap\"><table><thead><tr><th scope=\"col\">Reference</th><th scope=\"col\">Object ID</th></tr></thead><tbody id=\"refs\"></tbody></table></div><div class=\"empty hidden\" id=\"empty\">No references have been published yet.</div></section><details><summary>Active WAL chain</summary><p class=\"hint\">Entries are listed in replay order. Superseded objects remain in storage until a separate retention policy removes them.</p><ol id=\"entries\"></ol></details><p class=\"foot\">This view reports durable repository state. It does not measure process health, transfer throughput, or local cache size.</p></div></main><script>\n    (() => \{\n      'use strict';\n      const $ = id => document.getElementById(id);\n      let repository = '';\n      let token = '';\n      let timer = null;\n      let request = null;\n      let generation = 0;\n\n      const status = (text, kind = '') => \{\n        $('status').textContent = text;\n        $('status').className = 'status ' + kind;\n      \};\n\n      const schedule = () => \{\n        clearInterval(timer);\n        timer = null;\n        if ($('live').checked && repository) timer = setInterval(refresh, 15000);\n      \};\n\n      function clearState() \{\n        $('retry').classList.add('hidden');\n        generation++;\n        request?.abort();\n        request = null;\n        repository = '';\n        token = '';\n        $('token').value = '';\n        $('live').checked = false;\n        schedule();\n        $('dashboard').classList.add('hidden');\n        $('refs').replaceChildren();\n        $('entries').replaceChildren();\n        $('refresh').disabled = false;\n        $('open').disabled = false;\n      \}\n\n      async function refresh() \{\n        if (!repository || request) return;\n        $('retry').classList.add('hidden');\n        const current = generation;\n        request = new AbortController();\n        const controller = request;\n        const timeout = setTimeout(() => controller.abort(), 30000);\n        $('refresh').disabled = true;\n        $('open').disabled = true;\n        status('Reading the published index…');\n        try \{\n          const headers = \{ Accept: 'application/json' \};\n          if (token) headers.Authorization = 'Bearer ' + token;\n          const response = await fetch('/' + encodeURIComponent(repository) + '/monitor', \{\n            headers,\n            cache: 'no-store',\n            credentials: 'omit',\n            redirect: 'error',\n            signal: controller.signal,\n          \});\n          if (!response.ok) \{\n            throw new Error(response.status === 403 || response.status === 404\n              ? 'Repository unavailable. Check its name and access token.'\n              : response.status === 503\n                ? 'Storage or cache is temporarily unavailable. Try again.'\n                : 'Could not read the repository (' + response.status + ').');\n          \}\n          const index = await response.json();\n          if (current !== generation) return;\n          if (!Array.isArray(index.refs) || !Array.isArray(index.entries) || !Array.isArray(index.superseded)) \{\n            throw new Error('The server returned an invalid repository index.');\n          \}\n          $('title').textContent = repository;\n          $('refs-count').textContent = index.refs.length;\n          $('wal-count').textContent = index.entries.length;\n          $('old-count').textContent = index.superseded.length;\n          $('format').textContent = (index.object_format || 'sha1').toUpperCase();\n          $('head').textContent = index.head ? 'HEAD → ' + index.head : 'HEAD is not set';\n          $('refs').replaceChildren();\n          for (const ref of index.refs) \{\n            const row = document.createElement('tr');\n            const name = document.createElement('td');\n            name.textContent = ref.name;\n            const id = document.createElement('td');\n            const code = document.createElement('code');\n            code.textContent = ref.oid;\n            id.append(code);\n            row.append(name, id);\n            $('refs').append(row);\n          \}\n          $('empty').classList.toggle('hidden', index.refs.length > 0);\n          $('entries').replaceChildren();\n          for (const entry of index.entries) \{\n            const item = document.createElement('li');\n            item.textContent = entry;\n            $('entries').append(item);\n          \}\n          $('dashboard').classList.remove('hidden');\n          status('Published state checked at ' + new Date().toLocaleTimeString() + '.', 'ok');\n        \} catch (error) \{\n          if (current !== generation) return;\n          $('retry').classList.remove('hidden');\n          $('dashboard').classList.add('hidden');\n          $('live').checked = false;\n          schedule();\n          status(error.name === 'AbortError' ? 'The request timed out. Try again.' : error.message, 'error');\n        \} finally \{\n          clearTimeout(timeout);\n          if (current === generation) \{\n            request = null;\n            $('refresh').disabled = false;\n            $('open').disabled = false;\n          \}\n        \}\n      \}\n\n      $('connect').addEventListener('submit', event => \{\n        event.preventDefault();\n        const name = $('repository').value.trim();\n        const credential = $('token').value.trim();\n        if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(name)) \{\n          status('Use a flat repository name, without paths or spaces.', 'error');\n          return;\n        \}\n        clearState();\n        repository = name;\n        token = credential;\n        refresh();\n      \});\n      $('refresh').addEventListener('click', refresh);\n      $('retry').addEventListener('click', refresh);\n      $('live').addEventListener('change', schedule);\n      $('disconnect').addEventListener('click', () => \{\n        clearState();\n        status('Disconnected. The access token has been cleared.');\n        $('repository').focus();\n      \});\n      window.addEventListener('pagehide', clearState);\n    \})();\n  </script></body></html>",
    #{
      "content-type": "text/html; charset=utf-8",
      "cache-control": "no-store",
      "referrer-policy": "no-referrer",
      "x-content-type-options": "nosniff",
      "content-security-policy": "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'",
    },
