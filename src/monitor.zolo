//! A read-only repository monitor composed with Verniz Views.
use std::http
use std::html::{
  self,
  View, document, head, meta, title, body, main, header, div, span, form,
  label, input, button, p, h1, h2, dl, dt, dd, section, table, thead, tr, th, tbody,
  details, summary, ol, script, br,
}

fn ConnectForm() -> View {
  <>
    <form id="connect">
      <label>
        Repository
        <input
          id="repository"
          placeholder="project.git"
          autocomplete="off"
          required
          spellcheck="false"
          maxlength="100"
        />
      </label>
      <label>
        Access token <span style="font-weight:400;color:var(--muted)">· optional for public repositories</span>
        <input
          id="token"
          type="password"
          placeholder="zgw_…"
          autocomplete="off"
          spellcheck="false"
        />
      </label>
      <button class="primary" id="open" type="submit">Open repository</button>
    </form>
    <p class="hint">
      Your token stays in this page's memory. It is never put in the address, saved to browser storage, or sent to another host.
    </p>
    <p id="status" class="status" role="status" aria-live="polite">
      Choose a repository to inspect its published state.
    </p>
    <button id="retry" class="hidden" type="button">Try again</button>
  </>
}

fn Metric(label: str, target: str, textual: bool = false) -> View {
  <div class="metric">
    <dt>{label}</dt>
    <dd id={target} class={if textual { "text" } else { "" }}>—</dd>
  </div>
}

fn References() -> View {
  <section class="panel">
    <div class="panel-head">
      <h2>References</h2>
      <span id="head"></span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Reference</th>
            <th scope="col">Object ID</th>
          </tr>
        </thead>
        <tbody id="refs"></tbody>
      </table>
    </div>
    <div class="empty hidden" id="empty">No references have been published yet.</div>
  </section>
}

fn Dashboard() -> View {
  <div id="dashboard" class="hidden">
    <div class="toolbar">
      <h2 id="title"></h2>
      <div class="actions">
        <label><input type="checkbox" id="live" />Refresh every 15 seconds</label>
        <button id="refresh" type="button">Refresh now</button>
        <button id="disconnect" type="button">Disconnect</button>
      </div>
    </div>
    <dl class="metrics">
      <Metric label="Published references" target="refs-count" />
      <Metric label="Active WAL entries" target="wal-count" />
      <Metric label="Superseded entries" target="old-count" />
      <Metric label="Object format" target="format" textual={true} />
    </dl>
    <References />
    <details>
      <summary>Active WAL chain</summary>
      <p class="hint">
        Entries are listed in replay order. Superseded objects remain in storage until a separate retention policy removes them.
      </p>
      <ol id="entries"></ol>
    </details>
    <p class="foot">
      This view reports durable repository state. It does not measure process health, transfer throughput, or local cache size.
    </p>
  </div>
}

fn Controller() -> View {
  <script>
    (() => {
      'use strict';
      const $ = id => document.getElementById(id);
      let repository = '';
      let token = '';
      let timer = null;
      let request = null;
      let generation = 0;

      const status = (text, kind = '') => {
        $('status').textContent = text;
        $('status').className = 'status ' + kind;
      };

      const schedule = () => {
        clearInterval(timer);
        timer = null;
        if ($('live').checked && repository) timer = setInterval(refresh, 15000);
      };

      function clearState() {
        $('retry').classList.add('hidden');
        generation++;
        request?.abort();
        request = null;
        repository = '';
        token = '';
        $('token').value = '';
        $('live').checked = false;
        schedule();
        $('dashboard').classList.add('hidden');
        $('refs').replaceChildren();
        $('entries').replaceChildren();
        $('refresh').disabled = false;
        $('open').disabled = false;
      }

      async function refresh() {
        if (!repository || request) return;
        $('retry').classList.add('hidden');
        const current = generation;
        request = new AbortController();
        const controller = request;
        const timeout = setTimeout(() => controller.abort(), 30000);
        $('refresh').disabled = true;
        $('open').disabled = true;
        status('Reading the published index…');
        try {
          const headers = { Accept: 'application/json' };
          if (token) headers.Authorization = 'Bearer ' + token;
          const response = await fetch('/' + encodeURIComponent(repository) + '/monitor', {
            headers,
            cache: 'no-store',
            credentials: 'omit',
            redirect: 'error',
            signal: controller.signal,
          });
          if (!response.ok) {
            throw new Error(response.status === 403 || response.status === 404
              ? 'Repository unavailable. Check its name and access token.'
              : response.status === 503
                ? 'Storage or cache is temporarily unavailable. Try again.'
                : 'Could not read the repository (' + response.status + ').');
          }
          const index = await response.json();
          if (current !== generation) return;
          if (!Array.isArray(index.refs) || !Array.isArray(index.entries) || !Array.isArray(index.superseded)) {
            throw new Error('The server returned an invalid repository index.');
          }
          $('title').textContent = repository;
          $('refs-count').textContent = index.refs.length;
          $('wal-count').textContent = index.entries.length;
          $('old-count').textContent = index.superseded.length;
          $('format').textContent = (index.object_format || 'sha1').toUpperCase();
          $('head').textContent = index.head ? 'HEAD → ' + index.head : 'HEAD is not set';
          $('refs').replaceChildren();
          for (const ref of index.refs) {
            const row = document.createElement('tr');
            const name = document.createElement('td');
            name.textContent = ref.name;
            const id = document.createElement('td');
            const code = document.createElement('code');
            code.textContent = ref.oid;
            id.append(code);
            row.append(name, id);
            $('refs').append(row);
          }
          $('empty').classList.toggle('hidden', index.refs.length > 0);
          $('entries').replaceChildren();
          for (const entry of index.entries) {
            const item = document.createElement('li');
            item.textContent = entry;
            $('entries').append(item);
          }
          $('dashboard').classList.remove('hidden');
          status('Published state checked at ' + new Date().toLocaleTimeString() + '.', 'ok');
        } catch (error) {
          if (current !== generation) return;
          $('retry').classList.remove('hidden');
          $('dashboard').classList.add('hidden');
          $('live').checked = false;
          schedule();
          status(error.name === 'AbortError' ? 'The request timed out. Try again.' : error.message, 'error');
        } finally {
          clearTimeout(timeout);
          if (current === generation) {
            request = null;
            $('refresh').disabled = false;
            $('open').disabled = false;
          }
        }
      }

      $('connect').addEventListener('submit', event => {
        event.preventDefault();
        const name = $('repository').value.trim();
        const credential = $('token').value.trim();
        if (!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(name)) {
          status('Use a flat repository name, without paths or spaces.', 'error');
          return;
        }
        clearState();
        repository = name;
        token = credential;
        refresh();
      });
      $('refresh').addEventListener('click', refresh);
      $('retry').addEventListener('click', refresh);
      $('live').addEventListener('change', schedule);
      $('disconnect').addEventListener('click', () => {
        clearState();
        status('Disconnected. The access token has been cleared.');
        $('repository').focus();
      });
      window.addEventListener('pagehide', clearState);
    })();
  </script>
}

pub fn view() -> View {
  <document lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width,initial-scale=1" />
      <title>Gitwal · Repository monitor</title>
      <style global>
        :root {
          color-scheme: dark;
          --bg: #0e141b;
          --surface: #151e28;
          --line: #2b3745;
          --muted: #9aaabb;
          --ink: #eff5fa;
          --mint: #a4e7be;
          --error: #ffaaaa;
          font: 15px/1.55 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif
        }
        * {
          box-sizing: border-box
        }
        body {
          margin: 0;
          background: var(--bg);
          color: var(--ink)
        }
        main {
          max-width: 1120px;
          margin: auto;
          padding: 40px 28px 64px
        }
        header {
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 20px;
          margin-bottom: 64px
        }
        .brand {
          font-weight: 750;
          letter-spacing: -.06em;
          font-size: 28px
        }
        .brand span {
          color: var(--mint)
        }
        .badge {
          border: 1px solid var(--line);
          border-radius: 24px;
          padding: 5px 12px;
          color: var(--muted);
          font-size: 12px;
          letter-spacing: .07em;
          text-transform: uppercase
        }
        .eyebrow {
          color: var(--mint);
          text-transform: uppercase;
          font-size: 12px;
          letter-spacing: .16em;
          margin: 0 0 12px
        }
        h1 {
          font-size: clamp(32px,5vw,54px);
          line-height: 1.12;
          letter-spacing: -.055em;
          margin: 0 0 16px
        }
        h2 {
          font-size: 18px;
          letter-spacing: -.025em;
          margin: 0
        }
        p {
          color: var(--muted);
          margin: 0
        }
        .intro {
          max-width: 680px;
          margin-bottom: 34px
        }
        form {
          display: grid;
          grid-template-columns: 1fr 1.2fr auto;
          gap: 14px;
          align-items: end;
          background: var(--surface);
          border: 1px solid var(--line);
          padding: 22px;
          border-radius: 14px
        }
        label {
          display: block;
          font-weight: 600;
          font-size: 12px;
          color: #bfccda
        }
        input:not([type=checkbox]) {
          display: block;
          width: 100%;
          margin-top: 7px;
          padding: 12px 13px;
          background: var(--bg);
          border: 1px solid var(--line);
          border-radius: 7px;
          color: var(--ink);
          font: inherit
        }
        input:focus, button:focus-visible {
          outline: 2px solid var(--mint);
          outline-offset: 3px
        }
        button {
          cursor: pointer;
          border: 1px solid var(--line);
          border-radius: 7px;
          padding: 12px 16px;
          background: transparent;
          color: var(--ink);
          font: 600 14px/1.5 system-ui
        }
        button.primary {
          background: var(--mint);
          border-color: var(--mint);
          color: #14251b
        }
        button:disabled {
          opacity: .55;
          cursor: wait
        }
        .hint {
          font-size: 12px;
          margin: 10px 0 28px
        }
        .status {
          min-height: 24px;
          font-size: 14px;
          display: flex;
          align-items: center;
          gap: 10px
        }
        .status.error {
          color: var(--error)
        }
        .status.ok:before {
          content: "";
          width: 7px;
          height: 7px;
          display: inline-block;
          background: var(--mint);
          border-radius: 50%
        }
        .toolbar {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 16px;
          margin: 30px 0 22px
        }
        .actions {
          display: flex;
          align-items: center;
          flex-wrap: wrap;
          gap: 14px
        }
        .actions label {
          display: flex;
          align-items: center;
          gap: 7px
        }
        .actions button {
          padding: 8px 12px
        }
        .metrics {
          display: grid;
          grid-template-columns: repeat(4,1fr);
          gap: 16px;
          margin: 24px 0 34px
        }
        .metric {
          border: 1px solid var(--line);
          border-radius: 12px;
          padding: 22px;
          background: var(--surface)
        }
        .metric dt {
          color: var(--muted);
          font-size: 12px
        }
        .metric dd {
          font-size: 32px;
          letter-spacing: -.055em;
          margin: 7px 0 0
        }
        .metric dd.text {
          font-size: 21px;
          line-height: 1.5;
          overflow-wrap: anywhere
        }
        section.panel {
          border: 1px solid var(--line);
          border-radius: 12px;
          overflow: hidden;
          margin-bottom: 20px
        }
        .panel-head {
          display: flex;
          justify-content: space-between;
          gap: 18px;
          align-items: center;
          padding: 20px;
          background: var(--surface)
        }
        .panel-head span {
          color: var(--muted);
          font-size: 12px
        }
        .table-wrap {
          overflow: auto
        }
        table {
          border-collapse: collapse;
          width: 100%;
          font-size: 13px;
          text-align: left
        }
        th, td {
          padding: 15px 20px;
          border-top: 1px solid var(--line)
        }
        th {
          color: var(--muted);
          font-size: 11px;
          letter-spacing: .1em;
          text-transform: uppercase;
          font-weight: 500
        }
        td code {
          font-size: 12px;
          word-break: break-all
        }
        td:first-child {
          white-space: nowrap
        }
        .empty {
          padding: 32px 20px;
          color: var(--muted);
          font-size: 14px
        }
        details {
          border: 1px solid var(--line);
          border-radius: 12px;
          padding: 18px 20px
        }
        summary {
          cursor: pointer;
          font-weight: 600;
          font-size: 14px
        }
        ol {
          color: var(--muted);
          padding-left: 22px;
          max-height: 230px;
          overflow: auto;
          font: 12px/1.9 ui-monospace,monospace
        }
        .foot {
          margin-top: 34px;
          font-size: 12px
        }
        .hidden {
          display: none!important
        }
        @media(max-width:720px) {
          main {
            padding: 25px 18px
          }
          header {
            margin-bottom: 40px
          }
          form {
            grid-template-columns: 1fr
          }
          .metrics {
            grid-template-columns: 1fr 1fr;
            gap: 10px
          }
          .metric {
            padding: 16px
          }
          .toolbar {
            align-items: flex-start;
            flex-direction: column
          }
          .panel-head {
            align-items: flex-start;
            flex-direction: column;
            gap: 3px
          }
        }
      </style>
    </head>
    <body>
      <main>
        <header>
          <div class="brand">gitwal<span>.</span></div>
          <span class="badge">Repository monitor</span>
        </header>
        <div class="intro">
          <p class="eyebrow">Durable by design</p>
          <h1>Your repository,<br />from the source of truth.</h1>
          <p>
            Inspect published references and the durable write-ahead log. Each refresh reads the authoritative repository index.
          </p>
        </div>
        <ConnectForm />
        <Dashboard />
      </main>
      <Controller />
    </body>
  </document>
}

pub fn page() -> http::Response {
  http.response(
    200,
    view() |> html.render(),
    #{
      "content-type": "text/html; charset=utf-8",
      "cache-control": "no-store",
      "referrer-policy": "no-referrer",
      "x-content-type-options": "nosniff",
      "content-security-policy": "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'",
    },
  )
}
